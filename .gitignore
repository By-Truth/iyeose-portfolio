# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Deployment archives (zips made for manual upload to Hostinger) — never
# commit these, backend.zip in particular bundles real secrets.
*.zip

# Environment variables — never commit real credentials.
.env
.env.local
.env.*.local
!.env.example

# PHP backend secrets, local database, and uploaded files.
backend/config.php
backend/data/*.sqlite
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/.htaccess

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
