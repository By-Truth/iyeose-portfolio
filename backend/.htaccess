# Deny direct web access to everything in /backend by default (config.php,
# the SQLite database, lib/, bin/) — only backend/api/.htaccess re-opens the
# actual API entry points. Only relevant on Apache; other servers (nginx,
# PHP's built-in dev server) need the equivalent handled in their own config,
# see BACKEND_SETUP.md.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
