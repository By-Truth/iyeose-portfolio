# Copy this file to .env and point it at wherever the PHP backend (/backend) is served from.
# Local dev, e.g. running `php -S localhost:8000 -t backend`:
VITE_API_URL=http://localhost:8000
# Production, e.g. the backend deployed at a subdomain or subpath:
# VITE_API_URL=https://api.your-domain.com
